    <Style x:Key="ToggleButtonIconBaseStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Width" Value="50" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Opacity="0.01" Color="White" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <StackPanel>
                        <Border Background="{TemplateBinding Background}">
                            <ContentControl
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                <Path
                                    x:Name="PathIcon"
                                    Data="{StaticResource FullScreenGeometry}"
                                    Fill="{TemplateBinding Foreground}"
                                    Stretch="Uniform" />
                            </ContentControl>
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value=".9" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value=".6" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>


    <LinearGradientBrush x:Key="PrimaryBrush" o:Freeze="True" StartPoint="0,0" EndPoint="1,0">
        <GradientStop o:Freeze="True" Offset="0" Color="#326cf3" />
        <GradientStop o:Freeze="True" Offset="1" Color="#326cf3" />
    </LinearGradientBrush>

    <Style x:Key="loadingCirleStyle" TargetType="controls:LoadingCircle">
        <Setter Property="Width" Value="40" />
        <Setter Property="Foreground" Value="#326cf3" />
        <Setter Property="Height" Value="40" />
        <Setter Property="DotDiameter" Value="5" />
        <Setter Property="DotInterval" Value="30" />
        <Setter Property="DotOffSet" Value="60" />
        <Setter Property="DotDelayTime" Value="90" />
        <Setter Property="DotSpeed" Value="4" />
    </Style>
    <Style BasedOn="{StaticResource {x:Type fl:FlyleafHost}}" TargetType="{x:Type controls:LiveControl}">
        <Setter Property="DetachedPosition" Value="CenterCenter" />
        <Setter Property="DetachedFixedSize" Value="500,500" />
        <Setter Property="DetachedContent">
            <Setter.Value>
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="Purple"
                        Text="Detached Content" />
                </Grid>
            </Setter.Value>
        </Setter>
        <Setter Property="OverlayTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <Grid Name="PART_PlayingOverlay" Visibility="Collapsed">
                            <ToggleButton
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Foreground="White"
                                IsChecked="{Binding IsAttached, Mode=TwoWay}"
                                Style="{StaticResource ToggleButtonIconBaseStyle}" />
                        </Grid>
                        <Grid
                            x:Name="PART_NoVideoOverlay"
                            Background="#1A1A1A"
                            Visibility="Collapsed">
