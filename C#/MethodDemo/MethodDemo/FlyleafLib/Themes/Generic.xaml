                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding DetachedContent}"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="designMode:DesignerProperties.IsInDesignMode" Value="True">
                <Setter Property="Template" Value="{Binding RelativeSource={RelativeSource Self}, Path=OverlayTemplate}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="designMode:DesignerProperties.IsInDesignMode" Value="True" />
                    <Condition Property="OverlayTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type fl:FlyleafSharedOverlay}">
                            <Grid>
                                <ContentPresenter
                                    x:Name="Part_DetachedContent"
                                    Width="{TemplateBinding Width}"
                                    Height="{TemplateBinding Height}"
                                    Content="{TemplateBinding DetachedContent}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                <ContentPresenter
                                    x:Name="Part_OverlayContent"
                                    Width="{Binding ElementName=Part_DetachedContent, Path=ActualWidth}"
                                    Height="{Binding ElementName=Part_DetachedContent, Path=ActualHeight}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="DetachedContent" Value="{x:Null}">
                                    <Setter TargetName="Part_OverlayContent" Property="Width" Value="auto" />
                                    <Setter TargetName="Part_OverlayContent" Property="Height" Value="auto" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type fl:FlyleafHostOld}">

        <Setter Property="ActivityTimeout" Value="0" />
        <Setter Property="IsAttached" Value="True" />
        <Setter Property="IsFullScreen" Value="False" />
        <Setter Property="KeyBindings" Value="Surface" />
        <Setter Property="MouseBindings" Value="Both" />

        <Setter Property="OpenOnDrop" Value="Surface" />
        <Setter Property="SwapOnDrop" Value="Surface" />
        <Setter Property="SwapDragEnterOnShift" Value="Surface" />

        <Setter Property="ToggleFullScreenOnDoubleClick" Value="Surface" />

        <Setter Property="AttachedResize" Value="None" />
        <Setter Property="DetachedResize" Value="Surface" />
        <Setter Property="ResizeSensitivity" Value="6" />
        <Setter Property="KeepRatioOnResize" Value="False" />

        <Setter Property="AttachedDragMove" Value="SurfaceOwner" />
        <Setter Property="DetachedDragMove" Value="Surface" />

        <Setter Property="DetachedRememberPosition" Value="True" />
        <Setter Property="DetachedRememberSize" Value="True" />
        <Setter Property="DetachedTopMost" Value="False" />

        <Setter Property="PanMoveOnCtrl" Value="Surface" />
        <Setter Property="PanRotateOnShiftWheel" Value="Surface" />
        <Setter Property="PanZoomOnCtrlWheel" Value="Surface" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type fl:FlyleafHostOld}">
                    <ContentPresenter
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding DetachedContent}"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="designMode:DesignerProperties.IsInDesignMode" Value="True">
                <Setter Property="Template" Value="{Binding RelativeSource={RelativeSource Self}, Path=OverlayTemplate}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="designMode:DesignerProperties.IsInDesignMode" Value="True" />
                    <Condition Property="OverlayTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type fl:FlyleafHostOld}">
                            <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding DetachedContent}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                <ContentPresenter />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
    <Style BasedOn="{StaticResource {x:Type fl:FlyleafHost}}" TargetType="{x:Type controls:LiveControl}">
        <Setter Property="DetachedContent">
            <Setter.Value>
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="Purple"
                        Text="Detached Content" />
                </Grid>
            </Setter.Value>
        </Setter>
        <Setter Property="OverlayTemplate">
            <Setter.Value>
                <ControlTemplate>

                    <Grid>
                        <Grid Name="PART_PlayingOverlay" Visibility="Collapsed">
                            <ToggleButton
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="Black"
                                Content="Attach / Detach"
                                Foreground="DarkRed"
                                IsChecked="{Binding IsAttached, Mode=TwoWay}" />
                            <!--<StackPanel VerticalAlignment="Center">
                                     <TextBlock
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Foreground="DarkRed"
                                         Text="Template Host" />
                                     <TextBlock
                                         FontSize="20"
                                         Foreground="Purple"
                                         Text="{Binding IsAttached}" />
                                     <ToggleButton
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Background="Black"
                                         Content="Attach / Detach"
                                         Foreground="DarkRed"
                                         IsChecked="{Binding IsAttached, Mode=TwoWay}" />
                                 </StackPanel>-->
                        </Grid>
                        <Grid
                            x:Name="PART_NoVideoOverlay"
                            Background="#1A1A1A"
                            Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!--  Video Icon  -->
                                <Grid
                                    Width="80"
                                    Height="80"
                                    Margin="0,0,0,20">
                                    <Ellipse
                                        Width="80"
                                        Height="80"
                                        Fill="#333333" />
                                    <Path
                                        Width="32"
                                        Height="32"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                        Fill="#666666" />
                                </Grid>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="#CCCCCC"
                                    Text="No Video" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Foreground="Green"
                                    Text="{Binding Player.Status}" />
                            </StackPanel>
                        </Grid>
                        <Grid
                            x:Name="PART_VideoPlayFailOverlay"
                            Background="#1A1A1A"
                            Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!--  Video Icon  -->
                                <Grid
                                    Width="80"
                                    Height="80"
                                    Margin="0,0,0,20">
                                    <Ellipse
                                        Width="80"
                                        Height="80"
                                        Fill="#333333" />
                                    <Path
                                        Width="32"
                                        Height="32"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                        Fill="#666666" />
                                </Grid>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="#CCCCCC"
                                    Text="视频播放失败" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Foreground="Green"
                                    Text="{Binding Player.Status}" />
                            </StackPanel>
                        </Grid>
                        <Grid
                            x:Name="PART_LoadingOverlay"
                            Background="#AA000000"
                            Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!--  Loading Animation  -->
                                <Grid
                                    Width="60"
                                    Height="60"
                                    Margin="0,0,0,20">
                                    <Ellipse
                                        Width="60"
                                        Height="60"
                                        RenderTransformOrigin="0.5,0.5"
                                        Stroke="#4A90E2"
                                        StrokeDashArray="15,15"
                                        StrokeThickness="4">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="LoadingRotation" />
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation
                                                            Storyboard.TargetName="LoadingRotation"
                                                            Storyboard.TargetProperty="Angle"
                                                            From="0"
                                                            To="360"
                                                            Duration="0:0:2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <Ellipse
                                        Width="40"
                                        Height="40"
                                        RenderTransformOrigin="0.5,0.5"
                                        Stroke="#7BB3F0"
                                        StrokeDashArray="10,10"
                                        StrokeThickness="3">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="LoadingRotation2" />
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation
                                                            Storyboard.TargetName="LoadingRotation2"
                                                            Storyboard.TargetProperty="Angle"
                                                            From="360"
                                                            To="0"
                                                            Duration="0:0:1.5" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                </Grid>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Loading..." />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#CCCCCC"
                                    Text="Please wait while the media is being loaded..." />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Player.Status}" Value="Playing">
                            <Setter TargetName="PART_PlayingOverlay" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Player.Status}" Value="Opening">
                            <Setter TargetName="PART_LoadingOverlay" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Player.Status}" Value="Stopped">
                            <Setter TargetName="PART_NoVideoOverlay" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Player.Status}" Value="Failed">
                            <Setter TargetName="PART_VideoPlayFailOverlay" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>

            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>