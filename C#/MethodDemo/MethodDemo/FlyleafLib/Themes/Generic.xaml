                                <Grid
                                    Width="80"
                                    Height="80"
                                    Margin="0,0,0,20">
                                    <Ellipse
                                        Width="80"
                                        Height="80"
                                        Fill="#333333" />
                                    <Path
                                        Width="32"
                                        Height="32"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                        Fill="#666666" />
                                </Grid>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="#CCCCCC"
                                    Text="暂无视频播放" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Foreground="Green"
                                    Text="{Binding Player.Status}" />
                            </StackPanel>
                        </Grid>
                        <Grid
                            x:Name="PART_VideoPlayFailOverlay"
                            Background="#1A1A1A"
                            Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!--  Video Icon  -->
                                <Grid
                                    Width="80"
                                    Height="80"
                                    Margin="0,0,0,20">
                                    <Ellipse
                                        Width="80"
                                        Height="80"
                                        Fill="#333333" />
                                    <Path
                                        Width="32"
                                        Height="32"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                        Fill="#666666" />
                                </Grid>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="#CCCCCC"
                                    Text="视频播放失败" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Foreground="Green"
                                    Text="{Binding Player.Status}" />
                            </StackPanel>
                        </Grid>
                        <Grid
