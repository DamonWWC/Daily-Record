                                        StrokeThickness="3">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="LoadingRotation2" />
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation
