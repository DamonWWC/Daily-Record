<UserControl x:Class="WPFDeveloper.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    
    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#ffffff"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#667eea"/>
        <SolidColorBrush x:Key="SecondaryColor" Color="#f093fb"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1a202c"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#4a5568"/>
        <SolidColorBrush x:Key="BorderColor" Color="#e2e8f0"/>
        <SolidColorBrush x:Key="HoverColor" Color="#edf2f7"/>
        
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>
        
        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.1" BlurRadius="8"/>
        <FontFamily x:Key="ModernFont">Segoe UI</FontFamily>
    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
        <StackPanel Margin="0,0,0,20">
            <!-- 应用信息卡片 -->
            <Border Background="{StaticResource PrimaryGradient}" 
                    CornerRadius="16" 
                    Padding="32,24" 
                    Margin="0,0,0,24"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="WPFDeveloper" 
                               FontSize="32" 
                               FontWeight="Bold" 
                               Foreground="White"
                               FontFamily="{StaticResource ModernFont}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="技术收集与实现平台" 
                               FontSize="18" 
                               Foreground="White" 
                               Opacity="0.9"
                               FontFamily="{StaticResource ModernFont}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>
                    <TextBlock Text="版本 1.0.0" 
                               FontSize="14" 
                               Foreground="White" 
                               Opacity="0.8"
                               FontFamily="{StaticResource ModernFont}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <!-- 功能特性卡片 -->
            <Border Background="{StaticResource CardBackground}" 
                    CornerRadius="12" 
                    Padding="24" 
                    Margin="0,0,0,24"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="功能特性" 
                               FontSize="20" 
                               FontWeight="SemiBold"
                               FontFamily="{StaticResource ModernFont}"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,16"/>
                    
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Ellipse Grid.Row="0" Grid.Column="0" Width="8" Height="8" Fill="{StaticResource PrimaryColor}" Margin="0,0,12,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                   Text="MVVM 架构设计，代码结构清晰" 
                                   FontSize="14"
                                   FontFamily="{StaticResource ModernFont}"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        
                        <Ellipse Grid.Row="1" Grid.Column="0" Width="8" Height="8" Fill="{StaticResource SecondaryColor}" Margin="0,0,12,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" 
                                   Text="模块化导航系统，易于扩展" 
                                   FontSize="14"
                                   FontFamily="{StaticResource ModernFont}"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,8,0,0"/>
                        
                        <Ellipse Grid.Row="2" Grid.Column="0" Width="8" Height="8" Fill="{StaticResource PrimaryColor}" Margin="0,0,12,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" 
                                   Text="现代化 UI 设计，用户体验优秀" 
                                   FontSize="14"
                                   FontFamily="{StaticResource ModernFont}"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- 技术栈卡片 -->
            <Border Background="{StaticResource CardBackground}" 
                    CornerRadius="12" 
                    Padding="24" 
                    Margin="0,0,0,24"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="技术栈" 
                               FontSize="20" 
                               FontWeight="SemiBold"
                               FontFamily="{StaticResource ModernFont}"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,16"/>
                    
                    <WrapPanel>
                        <Border Background="{StaticResource HoverColor}" 
                                CornerRadius="20" 
                                Padding="12,6" 
                                Margin="0,0,8,8">
                            <TextBlock Text=".NET 8.0" 
                                       FontSize="12"
                                       FontFamily="{StaticResource ModernFont}"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </Border>
                        
                        <Border Background="{StaticResource HoverColor}" 
                                CornerRadius="20" 
                                Padding="12,6" 
                                Margin="0,0,8,8">
                            <TextBlock Text="WPF" 
                                       FontSize="12"
                                       FontFamily="{StaticResource ModernFont}"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </Border>
                        
                        <Border Background="{StaticResource HoverColor}" 
                                CornerRadius="20" 
                                Padding="12,6" 
                                Margin="0,0,8,8">
                            <TextBlock Text="MVVM" 
                                       FontSize="12"
                                       FontFamily="{StaticResource ModernFont}"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </Border>
                        
                        <Border Background="{StaticResource HoverColor}" 
                                CornerRadius="20" 
                                Padding="12,6" 
                                Margin="0,0,8,8">
                            <TextBlock Text="Dependency Injection" 
                                       FontSize="12"
                                       FontFamily="{StaticResource ModernFont}"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </Border>
                        
                        <Border Background="{StaticResource HoverColor}" 
                                CornerRadius="20" 
                                Padding="12,6" 
                                Margin="0,0,8,8">
                            <TextBlock Text="CommunityToolkit.Mvvm" 
                                       FontSize="12"
                                       FontFamily="{StaticResource ModernFont}"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>
            
            <!-- 联系信息卡片 -->
            <Border Background="{StaticResource CardBackground}" 
                    CornerRadius="12" 
                    Padding="24" 
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="联系信息" 
                               FontSize="20" 
                               FontWeight="SemiBold"
                               FontFamily="{StaticResource ModernFont}"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,16"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="项目地址：" 
                                   FontSize="14"
                                   FontFamily="{StaticResource ModernFont}"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="GitHub Repository" 
                                   FontSize="14"
                                   FontFamily="{StaticResource ModernFont}"
                                   Foreground="{StaticResource PrimaryColor}"
                                   TextDecorations="Underline"
                                   Cursor="Hand"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="开发语言：" 
                                   FontSize="14"
                                   FontFamily="{StaticResource ModernFont}"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="C# / XAML" 
                                   FontSize="14"
                                   FontFamily="{StaticResource ModernFont}"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="许可证：" 
                                   FontSize="14"
                                   FontFamily="{StaticResource ModernFont}"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="MIT License" 
                                   FontSize="14"
                                   FontFamily="{StaticResource ModernFont}"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>


