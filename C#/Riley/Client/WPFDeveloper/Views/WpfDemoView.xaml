<UserControl x:Class="WPFDeveloper.Views.WpfDemoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    
    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#ffffff"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#667eea"/>
        <SolidColorBrush x:Key="SecondaryColor" Color="#f093fb"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1a202c"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#4a5568"/>
        <SolidColorBrush x:Key="BorderColor" Color="#e2e8f0"/>
        <SolidColorBrush x:Key="HoverColor" Color="#edf2f7"/>
        
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>
        
        <DropShadowEffect x:Key="CardShadow" Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.1" BlurRadius="8"/>
        <FontFamily x:Key="ModernFont">Segoe UI</FontFamily>
    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
        <StackPanel Margin="0,0,0,20">
            <!-- 标题卡片 -->
            <Border Background="{StaticResource PrimaryGradient}" 
                    CornerRadius="16" 
                    Padding="32,24" 
                    Margin="0,0,0,24"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="WPF 技术演示" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="White"
                               FontFamily="{StaticResource ModernFont}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="展示各种 WPF 技术的实际应用" 
                               FontSize="16" 
                               Foreground="White" 
                               Opacity="0.9"
                               FontFamily="{StaticResource ModernFont}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            
            <!-- 技术演示卡片 -->
            <UniformGrid Columns="2" Margin="0,0,0,24">
                <!-- 控件演示 -->
                <Border Background="{StaticResource CardBackground}" 
                        CornerRadius="12" 
                        Padding="24" 
                        Margin="0,0,16,16"
                        Effect="{StaticResource CardShadow}"
                        Cursor="Hand">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
                                    <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    
                    <StackPanel>
                        <TextBlock Text="🖥️" 
                                   FontSize="48" 
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16"/>
                        <TextBlock Text="控件演示" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"
                                   FontFamily="{StaticResource ModernFont}"
                                   Foreground="{StaticResource TextPrimary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="展示各种 WPF 控件的使用方法" 
                                   FontSize="14"
                                   FontFamily="{StaticResource ModernFont}"
                                   Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                
                <!-- 绑定演示 -->
                <Border Background="{StaticResource CardBackground}" 
                        CornerRadius="12" 
                        Padding="24" 
                        Margin="16,0,0,16"
                        Effect="{StaticResource CardShadow}"
                        Cursor="Hand">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
                                    <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    
                    <StackPanel>
                        <TextBlock Text="🔗" 
                                   FontSize="48" 
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16"/>
                        <TextBlock Text="数据绑定" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"
                                   FontFamily="{StaticResource ModernFont}"
                                   Foreground="{StaticResource TextPrimary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="演示数据绑定的各种用法" 
                                   FontSize="14"
                                   FontFamily="{StaticResource ModernFont}"
                                   Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            
            <!-- 状态信息 -->
            <Border Background="{StaticResource CardBackground}" 
                    CornerRadius="12" 
                    Padding="24" 
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="动态视图创建成功！" 
                               FontSize="20" 
                               FontWeight="SemiBold"
                               FontFamily="{StaticResource ModernFont}"
                               Foreground="{StaticResource TextPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>
                    
                    <TextBlock Text="这个视图是通过配置文件中的 ViewType 动态创建的，展示了系统的灵活性。" 
                               FontSize="14"
                               FontFamily="{StaticResource ModernFont}"
                               Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
