<Window
    x:Class="Flyleaf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Flyleaf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Flyleaf Video Player"
    Width="1000"
    Height="600"
    MinWidth="600"
    MinHeight="400"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D30" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF3E3E42" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF1E1E1E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF666666" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="5,2" />
        </Style>
    </Window.Resources>

    <Grid Name="maingrid" Background="#FFF0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <!--  Video Player Area  -->
            <Border
                Grid.Column="0"
                Margin="10"
                Background="Black"
                BorderBrush="#FFCCCCCC"
                BorderThickness="1">
                <local:FlyleafVideoNewControl x:Name="flyleaf" IsAutoSnapShot="True" />
            </Border>
            <Border
                Grid.Column="1"
                Margin="10"
                Background="Black"
                BorderBrush="#FFCCCCCC"
                BorderThickness="1">
                <local:FlyleafVideoNewControl x:Name="flyleaf1" CameraInfo="123" />
            </Border>
        </Grid>


        <!--  Control Panel  -->
        <Border
            Grid.Row="1"
            Padding="10"
            Background="White"
            BorderBrush="#FFCCCCCC"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Playback Controls  -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button
                        x:Name="PlayStopButton"
                        Click="Button_Click"
                        Content="⏸️ Stop"
                        Style="{StaticResource ModernButtonStyle}"
                        ToolTip="Play/Stop video playback" />

                    <Button
                        x:Name="SnapshotButton"
                        Click="SnapshotButton_Click"
                        Content="📷 Snapshot"
                        Style="{StaticResource ModernButtonStyle}"
                        ToolTip="Take a snapshot of current frame" />
                </StackPanel>

                <!--  URL Input  -->
                <StackPanel
                    Grid.Column="1"
                    Margin="20,0"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Video URL:" />
                    <TextBox
                        x:Name="UrlTextBox"
                        Width="300"
                        Height="25"
                        VerticalAlignment="Center"
                        Text="rtmp://ns8.indexforce.com/home/mystream"
                        ToolTip="Enter video URL (RTMP, HTTP, local file path)" />
                    <Button
                        x:Name="LoadUrlButton"
                        Click="LoadUrlButton_Click"
                        Content="Load"
                        Style="{StaticResource ModernButtonStyle}"
                        ToolTip="Load the specified URL" />
                </StackPanel>

                <!--  Additional Controls  -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button
                        x:Name="FullscreenButton"
                        Click="FullscreenButton_Click"
                        Content="⛶ Fullscreen"
                        Style="{StaticResource ModernButtonStyle}"
                        ToolTip="Toggle fullscreen mode" />
                </StackPanel>
            </Grid>
        </Border>


    </Grid>
</Window>
