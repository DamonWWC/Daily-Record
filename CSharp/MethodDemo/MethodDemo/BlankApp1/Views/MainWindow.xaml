        <!-- 示例1：任意控件附加通用悬浮提示（TextBlock） -->
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="将鼠标移到这里">
            <controls:HoverTipService.IsEnabled>true</controls:HoverTipService.IsEnabled>
            <controls:HoverTipService.Text>这是一段很长很长的提示文本，用来展示当内容超过一定尺寸时，弹出的提示会在内部通过 ScrollViewer 显示滚动条，并且支持鼠标滚轮滚动。为了更好地测试滚动效果，我们可以重复几段文本。换行一：当鼠标悬停在这里时，会看到一个包含多行文本的提示。换行二：使用滚轮即可上下滚动查看更多内容。换行三：确保在 MaxWidth 和 MaxHeight 限制下可以滚动显示。换行四：WPF ScrollViewer 支持垂直与水平滚动。换行五：结束。</controls:HoverTipService.Text>
            <controls:HoverTipService.MaxWidth>260</controls:HoverTipService.MaxWidth>
            <controls:HoverTipService.MaxHeight>140</controls:HoverTipService.MaxHeight>
        </TextBlock>
        
        <!-- 示例2：也可继续使用封装控件（保留） -->
        <controls:ScrollableTooltipTextBlock
            Margin="5,0"
            VerticalAlignment="Top"
            TooltipMaxWidth="220"
            TooltipMaxHeight="140"
            Text="Hover me for long tooltip"
            ToolTipText="这是一段很长很长的提示文本，用来展示当内容超过一定尺寸时，Tooltip 会在内部通过 ScrollViewer 显示滚动条，并且支持鼠标滚轮滚动。为了更好地测试滚动效果，我们可以重复几段文本。换行一：当鼠标悬停在这里时，会看到一个包含多行文本的提示。换行二：使用滚轮即可上下滚动查看更多内容。换行三：确保在 MaxWidth 和 MaxHeight 限制下可以滚动显示。换行四：WPF ScrollViewer 支持垂直与水平滚动。换行五：结束。" />
