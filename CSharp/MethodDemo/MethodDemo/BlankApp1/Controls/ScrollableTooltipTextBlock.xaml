<UserControl
    x:Class="BlankApp1.Controls.ScrollableTooltipTextBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignWidth="300"
    d:DesignHeight="40">
    <Grid>
        <TextBlock x:Name="HostText"
                   Padding="0"
                   Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   MouseEnter="Host_MouseEnter"
                   MouseLeave="Host_MouseLeave"/>

        <Popup x:Name="TipPopup"
               PlacementTarget="{Binding ElementName=HostText}"
               Placement="Bottom"
               AllowsTransparency="True"
               Focusable="False"
               
               StaysOpen="True"
               IsOpen="False">
            <Border Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"
                    BorderThickness="1"
                    MaxWidth="{Binding TooltipMaxWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    MaxHeight="{Binding TooltipMaxHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    MouseEnter="Popup_MouseEnter"
                    MouseLeave="Popup_MouseLeave">
                <ScrollViewer CanContentScroll="True"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                    <TextBlock Margin="8"
                               Text="{Binding ToolTipText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
