                <PathGeometry>M170.8032 786.6368h240.0256v65.536H170.8032z</PathGeometry>
                <PathGeometry>M170.668032 852.035584v-240.0256h65.536v240.0256zM778.469376 823.67488l-169.578496-169.578496 46.340096-46.340096 169.578496 169.578496z</PathGeometry>
                <PathGeometry>M787.68128 852.103168v-240.0256h65.536v240.0256z</PathGeometry>
                <PathGeometry>M853.129216 852.099072h-240.0256v-65.536h240.0256zM824.653824 246.767616l-169.576448 169.578496-46.340096-46.340096 169.576448-169.578496z</PathGeometry>
                <PathGeometry>M853.245952 237.408256h-240.0256v-65.536h240.0256z</PathGeometry>
                <PathGeometry>M853.159936 171.927552v240.0256h-65.536v-240.0256zM245.682176 200.310784l169.576448 169.578496-46.340096 46.340096-169.576448-169.578496z</PathGeometry>
                <PathGeometry>M236.161024 171.804672v240.0256h-65.536v-240.0256z</PathGeometry>
                <PathGeometry>M170.8032 171.8272h240.0256v65.536H170.8032z</PathGeometry>
            </GeometryGroup>
