<UserControl
    x:Class="WPFDeveloper.Controls.ExternalProcessHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFDeveloper.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:WPFDeveloper.Converters"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  样式定义  -->
        <SolidColorBrush x:Key="HostBackgroundBrush" Color="#f8fafc" />
        <SolidColorBrush x:Key="HostBorderBrush" Color="#e2e8f0" />
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#ffffff" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1a202c" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4a5568" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#48bb78" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#f56565" />
        <SolidColorBrush x:Key="WarningBrush" Color="#ed8936" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!--  阴影效果  -->
        <DropShadowEffect
            x:Key="ControlShadow"
            BlurRadius="4"
            Direction="270"
            Opacity="0.1"
            ShadowDepth="1"
            Color="#000000" />

        <!--  按钮样式  -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HostBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Effect="{StaticResource ControlShadow}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#f1f5f9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#e2e8f0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#f7fafc" />
                                <Setter Property="Foreground" Value="#a0aec0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  文本框样式  -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HostBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#667eea" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  控制面板  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,8"
            Padding="16,12"
            Background="{StaticResource ControlBackgroundBrush}"
            BorderBrush="{StaticResource HostBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Effect="{StaticResource ControlShadow}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  第一行：路径选择  -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="程序路径:" />

                    <TextBox
                        x:Name="ExePathTextBox"
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        Style="{StaticResource ModernTextBoxStyle}"
                        Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="请输入或选择要嵌入的EXE程序路径" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button
                            x:Name="QuickSelectButton"
                            Margin="0,0,4,0"
                            Click="QuickSelectButton_Click"
                            Content="快选"
                            Style="{StaticResource ModernButtonStyle}"
                            ToolTip="快速选择常用系统程序" />
                        
                        <Button
                            x:Name="BrowseButton"
                            Click="BrowseButton_Click"
                            Content="浏览..."
                            Style="{StaticResource ModernButtonStyle}"
                            ToolTip="浏览并选择EXE文件" />
                    </StackPanel>
                </Grid>

                <!--  第二行：参数和控制按钮  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="启动参数:" />

                    <TextBox
                        x:Name="ArgumentsTextBox"
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        Style="{StaticResource ModernTextBoxStyle}"
                        Text="{Binding StartupArguments, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="程序启动时的命令行参数（可选）" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button
                            x:Name="StartButton"
                            Click="StartButton_Click"
                            Content="启动程序"
                            IsEnabled="{Binding CanStartProcess}"
                            Style="{StaticResource ModernButtonStyle}"
                            ToolTip="启动并嵌入外部程序" />

                        <Button
                            x:Name="StopButton"
                            Click="StopButton_Click"
                            Content="停止程序"
                            IsEnabled="{Binding CanStopProcess}"
                            Style="{StaticResource ModernButtonStyle}"
                            ToolTip="停止当前嵌入的程序" />

                        <Button
                            x:Name="RefreshButton"
                            Click="RefreshButton_Click"
                            Content="刷新"
                            Style="{StaticResource ModernButtonStyle}"
                            ToolTip="刷新嵌入的程序窗口" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!--  程序宿主区域  -->
        <Border
            x:Name="HostBorder"
            Grid.Row="1"
            Background="{StaticResource HostBackgroundBrush}"
            BorderBrush="{StaticResource HostBorderBrush}"
            BorderThickness="2"
            CornerRadius="6"
            Effect="{StaticResource ControlShadow}">

            <Grid>
                <!--  占位符内容（当没有程序运行时显示）  -->
                <StackPanel
                    x:Name="PlaceholderPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsProcessRunning, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">

                    <Ellipse
                        Width="64"
                        Height="64"
                        Margin="0,0,0,16"
                        Fill="#cbd5e0"
                        HorizontalAlignment="Center" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="Medium"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="外部程序将在此区域显示" />

                    <TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="请选择程序路径并点击启动程序" />
                </StackPanel>

                <!--  实际的宿主窗口（这里会嵌入外部程序）  -->
                <Border
                    x:Name="ProcessHostArea"
                    Background="Transparent"
                    ClipToBounds="True" />
            </Grid>
        </Border>

        <!--  状态栏  -->
        <Border
            Grid.Row="2"
            Margin="0,8,0,0"
            Padding="16,8"
            Background="{StaticResource ControlBackgroundBrush}"
            BorderBrush="{StaticResource HostBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Effect="{StaticResource ControlShadow}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  状态信息  -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse
                        Width="8"
                        Height="8"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Fill="{Binding StatusColor}" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="{Binding StatusText}" />
                </StackPanel>

                <!--  进程信息  -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Visibility="{Binding IsProcessRunning, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <TextBlock
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{Binding ProcessInfo}" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{Binding ProcessUptime, StringFormat=运行时间: {0}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
