<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="logs/nlog-internal.log">

  <!-- 启用异步处理以提高性能 -->
  <extensions>
    <add assembly="NLog.Extensions.Logging"/>
  </extensions>

  <!-- 定义变量 -->
  <variable name="logDirectory" value="logs"/>
  <variable name="applicationName" value="WPFDeveloper"/>

  <!-- 定义输出目标 -->
  <targets async="true">
    
    <!-- 控制台输出 -->
    <target xsi:type="ColoredConsole" 
            name="console"
            layout="${longdate} [${level:uppercase=true}] ${logger:shortName=true} - ${message} ${exception:format=tostring}">
      <highlight-row condition="level == LogLevel.Debug" foregroundColor="Gray" />
      <highlight-row condition="level == LogLevel.Info" foregroundColor="White" />
      <highlight-row condition="level == LogLevel.Warn" foregroundColor="Yellow" />
      <highlight-row condition="level == LogLevel.Error" foregroundColor="Red" />
      <highlight-row condition="level == LogLevel.Fatal" foregroundColor="Magenta" />
    </target>

    <!-- Debug输出窗口 -->
    <target xsi:type="Debugger" 
            name="debugger"
            layout="${time} [${level:uppercase=true}] ${logger:shortName=true} - ${message}" />

    <!-- 文件输出 - 所有日志 -->
    <target xsi:type="File" 
            name="allfile"
            fileName="${logDirectory}/${applicationName}-all-${shortdate}.log"
            layout="${longdate} [${level:uppercase=true}] [${threadid}] ${logger} - ${message} ${exception:format=tostring}"
            archiveFileName="${logDirectory}/archive/${applicationName}-all-{#}.log"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="30"
            concurrentWrites="true"
            keepFileOpen="false" />

    <!-- 文件输出 - 错误日志 -->
    <target xsi:type="File" 
            name="errorfile"
            fileName="${logDirectory}/${applicationName}-error-${shortdate}.log"
            layout="${longdate} [${level:uppercase=true}] [${threadid}] ${logger} - ${message} ${exception:format=tostring}"
            archiveFileName="${logDirectory}/archive/${applicationName}-error-{#}.log"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="90"
            concurrentWrites="true"
            keepFileOpen="false" />

    <!-- 文件输出 - 性能日志 -->
    <target xsi:type="File" 
            name="performancefile"
            fileName="${logDirectory}/${applicationName}-performance-${shortdate}.log"
            layout="${longdate} [${threadid}] ${logger} - ${message}"
            archiveFileName="${logDirectory}/archive/${applicationName}-performance-{#}.log"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="7"
            concurrentWrites="true"
            keepFileOpen="false" />

  </targets>

  <!-- 定义日志记录规则 -->
  <rules>
    
    <!-- Microsoft框架日志 - 减少噪音 -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <!-- 性能日志 -->
    <logger name="*.Performance" minlevel="Trace" writeTo="performancefile" final="true" />
    
    <!-- 错误日志 -->
    <logger name="*" minlevel="Error" writeTo="errorfile" />
    
    <!-- 所有日志到文件 -->
    <logger name="*" minlevel="Debug" writeTo="allfile" />
    
    <!-- 开发环境：控制台和调试输出 -->
    <logger name="*" minlevel="Debug" writeTo="console,debugger" />

  </rules>
  
</nlog>
