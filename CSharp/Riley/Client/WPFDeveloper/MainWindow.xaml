<Window
    x:Class="WPFDeveloper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFDeveloper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:WPFDeveloper.ViewModels"
    Title="WPFDeveloper - 技术收集与实现"
    Width="1200"
    Height="700"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <!--  现代化颜色方案  -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#667eea" />
        <SolidColorBrush x:Key="PrimaryLightColor" Color="#764ba2" />
        <SolidColorBrush x:Key="SecondaryColor" Color="#f093fb" />
        <SolidColorBrush x:Key="SecondaryLightColor" Color="#f5576c" />
        <SolidColorBrush x:Key="BackgroundColor" Color="#f8fafc" />
        <SolidColorBrush x:Key="CardBackgroundColor" Color="#ffffff" />
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#1a202c" />
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#4a5568" />
        <SolidColorBrush x:Key="BorderColor" Color="#e2e8f0" />
        <SolidColorBrush x:Key="HoverColor" Color="#e2e8f0" />
        <SolidColorBrush x:Key="SelectedColor" Color="#667eea" />

        <!--  渐变画刷  -->
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#667eea" />
            <GradientStop Offset="1" Color="#764ba2" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SecondaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#f093fb" />
            <GradientStop Offset="1" Color="#f5576c" />
        </LinearGradientBrush>

        <!--  阴影效果  -->
        <DropShadowEffect
            x:Key="CardShadow"
            BlurRadius="8"
            Direction="270"
            Opacity="0.1"
            ShadowDepth="2"
            Color="#000000" />
        <DropShadowEffect
            x:Key="ElevatedShadow"
            BlurRadius="12"
            Direction="270"
            Opacity="0.15"
            ShadowDepth="4"
            Color="#000000" />

        <!--  字体  -->
        <FontFamily x:Key="ModernFont">Segoe UI</FontFamily>
    </Window.Resources>

    <Border
        Background="{StaticResource BackgroundColor}"
        CornerRadius="12"
        Effect="{StaticResource CardShadow}">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧导航栏  -->
            <Border
                Grid.Column="0"
                Margin="0,0,8,0"
                Background="{StaticResource CardBackgroundColor}"
                CornerRadius="12,0,0,12"
                Effect="{StaticResource CardShadow}">

                <DockPanel>
                    <!--  顶部标题区域  -->
                    <Border
                        Padding="20,16"
                        Background="{StaticResource PrimaryGradient}"
                        CornerRadius="12,0,0,0"
                        DockPanel.Dock="Top">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <Ellipse
                                Width="32"
                                Height="32"
                                Margin="0,0,12,0"
                                Fill="White" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource ModernFont}"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="技术导航" />
                        </StackPanel>
                    </Border>

                    <!--  导航列表区域  -->
                    <ScrollViewer
                        Margin="12,16,12,12"
                        Background="Transparent"
                        VerticalScrollBarVisibility="Auto">
                        <ListBox
                            x:Name="NavList"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding NavigationItems}"
                            SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,2"
                                        Padding="16,12"
                                        Background="Transparent"
                                        CornerRadius="8"
                                        Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!--  图标占位符  -->
                                            <Ellipse
                                                Grid.Column="0"
                                                Width="20"
                                                Height="20"
                                                Margin="0,0,12,0"
                                                Fill="{StaticResource PrimaryColor}" />

                                            <!--  标题  -->
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource ModernFont}"
                                                FontSize="14"
                                                FontWeight="Medium"
                                                Foreground="{StaticResource TextPrimaryColor}"
                                                Text="{Binding Title}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border
                                                    x:Name="Border"
                                                    Margin="0,2"
                                                    Padding="16,12"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SelectedColor}" />
                                                        <Setter Property="Effect" Value="{StaticResource ElevatedShadow}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource HoverColor}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!--  右侧内容区  -->
            <Border
                Grid.Column="1"
                Margin="8,0,0,0"
                Background="{StaticResource CardBackgroundColor}"
                CornerRadius="0,12,12,0"
                Effect="{StaticResource CardShadow}">

                <!--  顶部工具栏  -->
                <DockPanel>
                    <Border
                        Padding="24,16"
                        Background="{StaticResource CardBackgroundColor}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="0,0,0,1"
                        DockPanel.Dock="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- 左侧页面信息 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding PageIcon}"
                                    FontSize="24"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding PageTitle}"
                                        FontFamily="{StaticResource ModernFont}"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryColor}"/>
                                    <TextBlock
                                        Text="{Binding PageDescription}"
                                        FontFamily="{StaticResource ModernFont}"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryColor}"
                                        TextWrapping="Wrap"
                                        MaxWidth="400"/>
                                </StackPanel>
                            </StackPanel>
 
                            <!--  右侧操作按钮  -->
                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Border
                                    Margin="0,0,8,0"
                                    Padding="16,8"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Cursor="Hand">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource ModernFont}"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryColor}"
                                        Text="设置" />
                                </Border>
                                <Border
                                    Margin="0,0,8,0"
                                    Padding="16,8"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Cursor="Hand">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource ModernFont}"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryColor}"
                                        Text="帮助" />
                                </Border>
                                <Border
                                    x:Name="CloseButton"
                                    Padding="16,8"
                                    Background="{StaticResource SecondaryColor}"
                                    BorderBrush="{StaticResource SecondaryColor}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Cursor="Hand">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource ModernFont}"
                                        FontSize="12"
                                        Foreground="White"
                                        Text="关闭" />
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SecondaryLightColor}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource SecondaryLightColor}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  主内容区域  -->
                    <Border
                        Margin="0,0,0,0"
                        Padding="24,20"
                        Background="Transparent">
                        <ContentControl Content="{Binding CurrentView}" />
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
