<UserControl
    x:Class="WPFDeveloper.Views.ExternalProcessDemoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WPFDeveloper.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFDeveloper.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  样式资源  -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#f8fafc" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#ffffff" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1a202c" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4a5568" />
        <SolidColorBrush x:Key="BorderBrush" Color="#e2e8f0" />
        <SolidColorBrush x:Key="AccentBrush" Color="#667eea" />

        <!--  阴影效果  -->
        <DropShadowEffect
            x:Key="CardShadow"
            BlurRadius="8"
            Direction="270"
            Opacity="0.1"
            ShadowDepth="2"
            Color="#000000" />

        <!--  标题样式  -->
        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!--  描述文本样式  -->
        <Style x:Key="DescriptionTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <!--  卡片样式  -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Effect" Value="{StaticResource CardShadow}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  页面标题和说明  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,20"
            Padding="24,20"
            Style="{StaticResource CardStyle}">
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource TitleTextStyle}" Text="外部程序嵌入演示" />
                    
                    <TextBlock Style="{StaticResource DescriptionTextStyle}">
                        <Run Text="此功能演示如何在WPF应用程序中嵌入外部的EXE程序。" />
                        <LineBreak />
                        <Run Text="支持启动任意的Windows应用程序并将其嵌入到指定的区域中，实现无缝集成的用户体验。" />
                        <LineBreak />
                        <Run Text="嵌入的程序可以正常交互，支持鼠标点击、键盘输入等操作。" />
                    </TextBlock>

                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Border
                            Padding="8,4"
                            Background="#e6fffa"
                            BorderBrush="#38b2ac"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="#234e52"
                                Text="✓ 支持多种程序类型" />
                        </Border>
                        
                        <Border
                            Margin="8,0,0,0"
                            Padding="8,4"
                            Background="#f0fff4"
                            BorderBrush="#48bb78"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="#22543d"
                                Text="✓ 实时状态监控" />
                        </Border>
                        
                        <Border
                            Margin="8,0,0,0"
                            Padding="8,4"
                            Background="#fefcbf"
                            BorderBrush="#ecc94b"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="#744210"
                                Text="✓ 自动窗口调整" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!--  示例程序推荐  -->
                <Border
                    Grid.Column="1"
                    Padding="16,12"
                    Background="#f7fafc"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    
                    <StackPanel>
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="推荐测试程序:" />
                        
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="• 记事本 (notepad.exe)" />
                        
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="• 计算器 (calc.exe)" />
                        
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="• 画图程序 (mspaint.exe)" />
                        
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="• 任意三维程序" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!--  主要内容区域  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!--  左侧：程序嵌入区域  -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  区域标题  -->
                    <Border
                        Grid.Row="0"
                        Padding="20,16"
                        Background="{StaticResource AccentBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="8,8,0,0">
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Ellipse
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,12,0"
                                    Fill="White" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="外部程序运行区域" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="White"
                                Opacity="0.8"
                                Text="支持实时交互操作" />
                        </Grid>
                    </Border>

                    <!--  嵌入控件  -->
                    <controls:ExternalProcessHost
                        Grid.Row="1"
                        Margin="0" />
                </Grid>
            </Border>

            <!--  右侧：功能说明和操作指南  -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        
                        <!--  操作指南  -->
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="操作指南" />
                        
                        <Border
                            Margin="0,8,0,16"
                            Height="2"
                            Background="{StaticResource AccentBrush}"
                            HorizontalAlignment="Left"
                            Width="40" />

                        <StackPanel Margin="0,0,0,20">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="1. 选择程序路径" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Style="{StaticResource DescriptionTextStyle}"
                                Text="点击浏览按钮选择要嵌入的EXE程序，或直接在文本框中输入程序的完整路径。" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,20">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="2. 设置启动参数（可选）" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Style="{StaticResource DescriptionTextStyle}"
                                Text="如果程序需要特定的启动参数，可以在启动参数文本框中输入。" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,20">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="3. 启动程序" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Style="{StaticResource DescriptionTextStyle}"
                                Text="点击启动程序按钮，程序将会启动并自动嵌入到左侧区域中。" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,20">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="4. 程序交互" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Style="{StaticResource DescriptionTextStyle}"
                                Text="嵌入的程序支持正常的鼠标点击、键盘输入等交互操作，就像在独立窗口中运行一样。" />
                        </StackPanel>

                        <!--  技术特性  -->
                        <Border
                            Margin="0,20,0,0"
                            Padding="0,16,0,0"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                            
                            <StackPanel>
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="技术特性" />
                                
                                <Border
                                    Margin="0,8,0,16"
                                    Height="2"
                                    Background="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Left"
                                    Width="40" />

                                <StackPanel>
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="12,8"
                                        Background="#f0fff4"
                                        BorderBrush="#48bb78"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="Medium"
                                                Foreground="#22543d"
                                                Text="Win32 API 集成" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#2d5016"
                                                Text="使用SetParent等API实现窗口嵌入" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="12,8"
                                        Background="#e6fffa"
                                        BorderBrush="#38b2ac"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="Medium"
                                                Foreground="#234e52"
                                                Text="自动窗口管理" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#1a202c"
                                                Text="自动调整大小、移除边框和标题栏" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="12,8"
                                        Background="#fefcbf"
                                        BorderBrush="#ecc94b"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="Medium"
                                                Foreground="#744210"
                                                Text="进程生命周期管理" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#553c0f"
                                                Text="监控进程状态、优雅退出处理" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="12,8"
                                        Background="#fed7d7"
                                        BorderBrush="#fc8181"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="Medium"
                                                Foreground="#742a2a"
                                                Text="异常处理机制" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#553c3c"
                                                Text="完善的错误处理和日志记录" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
