<Page x:Class="WPFDeveloper.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:local="clr-namespace:WPFDeveloper.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AboutPage">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="关于WPF开发者工具" 
                       Style="{StaticResource TextBlockLargeBold}"
                       Margin="0,0,0,20"/>
            
            <hc:Card Width="600" Margin="8">
                <StackPanel Margin="20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="版本: " FontWeight="Bold"/>
                        <TextBlock Text="{Binding Version}"/>
                    </StackPanel>
                    
                    <TextBlock Text="{Binding Description}" 
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>
                    
                    <TextBlock Text="技术栈:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="• WPF (Windows Presentation Foundation)" Margin="10,0,0,0"/>
                    <TextBlock Text="• MVVM 架构模式" Margin="10,0,0,0"/>
                    <TextBlock Text="• CommunityToolkit.Mvvm" Margin="10,0,0,0"/>
                    <TextBlock Text="• HandyControl UI库" Margin="10,0,0,0"/>
                    
                    <TextBlock Text="开发者信息:" FontWeight="Bold" Margin="0,20,0,5"/>
                    <TextBlock Text="© 2023 WPF开发者团队" Margin="10,0,0,0"/>
                </StackPanel>
            </hc:Card>
        </StackPanel>
    </Grid>
</Page>