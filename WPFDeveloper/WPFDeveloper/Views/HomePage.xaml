<Page x:Class="WPFDeveloper.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:local="clr-namespace:WPFDeveloper.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding WelcomeMessage}"
                       Style="{StaticResource TextBlockLargeBold}"
                       Margin="0,0,0,20"/>
            <hc:Card Width="600" Margin="8">
                <StackPanel Margin="10">
                    <TextBlock Text="快速开始" 
                             Style="{StaticResource TextBlockTitleBold}"/>
                    <TextBlock Text="1. 在左侧导航栏选择功能" 
                             Margin="0,10,0,0"/>
                    <TextBlock Text="2. 根据需要配置相关选项" 
                             Margin="0,5,0,0"/>
                    <TextBlock Text="3. 点击执行按钮开始处理" 
                             Margin="0,5,0,0"/>
                </StackPanel>
            </hc:Card>
        </StackPanel>
    </Grid>
</Page>