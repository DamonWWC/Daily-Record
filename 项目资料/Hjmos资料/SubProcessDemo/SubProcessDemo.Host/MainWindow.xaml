<Window x:Class="SubProcessDemo.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="子进程快速启动方案 — 技术演示"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource BgDark}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 标题 -->
            <RowDefinition Height="Auto" />   <!-- 按钮栏 -->
            <RowDefinition Height="*" />      <!-- 主内容区 -->
            <RowDefinition Height="Auto" />   <!-- 性能对比 -->
        </Grid.RowDefinitions>

        <!-- ═══ 标题 ═══ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="子进程快速启动方案 — 技术演示"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource FgPrimary}" />
            <TextBlock Text="演示 5 个核心策略：预热池 / 共享内存 / 服务代理 / JIT预编译 / 分级加载"
                       FontSize="12" Foreground="{StaticResource FgSecondary}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- ═══ 按钮栏 ═══ -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12" HorizontalAlignment="Left">
            <Button Content="① 初始化预热池" x:Name="BtnWarmUp" Click="BtnWarmUp_Click" Margin="0,0,8,0" />

            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                <ComboBox x:Name="CmbModules" Width="150" Margin="0,0,4,0" />
                <Button Content="② 激活模块" x:Name="BtnActivate" Click="BtnActivate_Click" IsEnabled="False" />
            </StackPanel>

            <Button Content="③ 冷启动对比" x:Name="BtnColdStart" Click="BtnColdStart_Click" Margin="0,0,8,0" IsEnabled="False" />
            <Button Content="④ 服务代理测试" x:Name="BtnServiceProxy" Click="BtnServiceProxy_Click" Margin="0,0,8,0" IsEnabled="False" />
            <Button Content="⑤ 分级预热" x:Name="BtnTieredWarmUp" Click="BtnTieredWarmUp_Click" Margin="0,0,8,0" IsEnabled="False" />
            <Button Content="🔄 重置" x:Name="BtnReset" Click="BtnReset_Click" />
        </WrapPanel>

        <!-- ═══ 主内容区 ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：进程池状态 -->
            <Border Grid.Column="0" Background="{StaticResource BgCard}" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="进程池状态" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource FgAccent}" Margin="0,0,0,8" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PoolPanel" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右：实时日志 -->
            <Border Grid.Column="2" Background="{StaticResource BgCard}" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="实时日志" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource FgAccent}" />
                        <Button Content="清空" DockPanel.Dock="Right" Padding="8,2" FontSize="11"
                                Click="BtnClearLog_Click" HorizontalAlignment="Right" />
                    </DockPanel>

                    <ListBox Grid.Row="1" x:Name="LogList"
                             Background="#1A1A2A"
                             Foreground="{StaticResource FgSecondary}"
                             FontFamily="Cascadia Code,Consolas,Courier New"
                             FontSize="12"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ 性能对比 ═══ -->
        <Border Grid.Row="3" Background="{StaticResource BgCard}" CornerRadius="8" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="性能对比" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource FgAccent}" Margin="0,0,0,8" />

                <!-- 冷启动条 -->
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="冷启动" Foreground="{StaticResource FgSecondary}" FontSize="12" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="#1A1A2A" CornerRadius="4" Height="22">
                        <Border x:Name="ColdBar" Background="{StaticResource Red}" CornerRadius="4"
                                HorizontalAlignment="Left" Width="0" />
                    </Border>
                    <TextBlock Grid.Column="2" x:Name="ColdMsText" Text="—" Foreground="{StaticResource Red}"
                               FontSize="12" VerticalAlignment="Center" TextAlignment="Right" Margin="8,0,0,0" />
                </Grid>

                <!-- 热启动条 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="热启动" Foreground="{StaticResource FgSecondary}" FontSize="12" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="#1A1A2A" CornerRadius="4" Height="22">
                        <Border x:Name="WarmBar" Background="{StaticResource Green}" CornerRadius="4"
                                HorizontalAlignment="Left" Width="0" />
                    </Border>
                    <TextBlock Grid.Column="2" x:Name="WarmMsText" Text="—" Foreground="{StaticResource Green}"
                               FontSize="12" VerticalAlignment="Center" TextAlignment="Right" Margin="8,0,0,0" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
