<Application x:Class="SubProcessDemo.Host.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- 暗色主题基础样式 -->
        <SolidColorBrush x:Key="BgDark" Color="#1E1E2E" />
        <SolidColorBrush x:Key="BgCard" Color="#2A2A3C" />
        <SolidColorBrush x:Key="BgButton" Color="#3A3A5C" />
        <SolidColorBrush x:Key="BgButtonHover" Color="#4A4A6C" />
        <SolidColorBrush x:Key="FgPrimary" Color="#CDD6F4" />
        <SolidColorBrush x:Key="FgSecondary" Color="#A6ADC8" />
        <SolidColorBrush x:Key="FgAccent" Color="#89B4FA" />
        <SolidColorBrush x:Key="Green" Color="#A6E3A1" />
        <SolidColorBrush x:Key="Yellow" Color="#F9E2AF" />
        <SolidColorBrush x:Key="Red" Color="#F38BA8" />
        <SolidColorBrush x:Key="Blue" Color="#89B4FA" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgButton}" />
            <Setter Property="Foreground" Value="{StaticResource FgPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#4A4A6C" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgButtonHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgButton}" />
            <Setter Property="Foreground" Value="{StaticResource FgPrimary}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Application.Resources>
</Application>
