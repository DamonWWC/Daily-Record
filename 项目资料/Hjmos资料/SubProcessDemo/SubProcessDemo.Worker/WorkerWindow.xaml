<Window x:Class="SubProcessDemo.Worker.WorkerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Worker 子进程"
        Width="520" Height="480"
        Background="{StaticResource BgDark}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ 头部：状态信息 ═══ -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TitleText" Text="Worker 子进程"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource FgPrimary}" />
                    <TextBlock x:Name="PidText" Text="PID: —"
                               FontSize="12" Foreground="{StaticResource FgSecondary}" Margin="0,4,0,0" />
                    <TextBlock x:Name="PipeText" Text="管道: —"
                               FontSize="11" Foreground="{StaticResource FgSecondary}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border x:Name="StateBadge" Background="{StaticResource Yellow}"
                            CornerRadius="12" Padding="14,6" HorizontalAlignment="Right">
                        <TextBlock x:Name="StateText" Text="WarmingUp"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#1E1E2E" />
                    </Border>
                    <TextBlock x:Name="ElapsedText" Text="—"
                               FontSize="11" Foreground="{StaticResource FgAccent}"
                               HorizontalAlignment="Right" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ 当前步骤 ═══ -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                x:Name="StepPanel">
            <StackPanel>
                <TextBlock Text="当前步骤" FontSize="12" Foreground="{StaticResource FgSecondary}" Margin="0,0,0,4" />
                <TextBlock x:Name="StepText" Text="初始化中..."
                           FontSize="14" Foreground="{StaticResource FgAccent}" />
            </StackPanel>
        </Border>

        <!-- ═══ 日志 ═══ -->
        <Border Grid.Row="2" Background="{StaticResource BgCard}" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="日志" FontSize="12" Foreground="{StaticResource FgSecondary}" Margin="0,0,0,6" />
                <ListBox Grid.Row="1" x:Name="LogList"
                         Background="#11111B"
                         Foreground="{StaticResource FgSecondary}"
                         FontFamily="Cascadia Code,Consolas,Courier New"
                         FontSize="11.5"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </Grid>
        </Border>
    </Grid>
</Window>
